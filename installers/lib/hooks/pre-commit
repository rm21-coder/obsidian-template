#!/usr/bin/env bash
# pre-commit — classification audit gate for the obsidian-template repo.
#
# Refuses any commit that introduces or modifies a .md file in a user-
# content folder (Knowledge/, Meetings/, People/, etc.) without
# `classification: public` in its YAML frontmatter.
#
# To bypass for a single commit (audit override):
#     git commit --no-verify
#
# This hook is installed by:
#     ./installers/install-git-hooks.sh
#
# See installers/lib/check_classification.py for the audit logic and
# remediation guidance.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pre-commit: not a git repository, skipping classification audit." >&2
    exit 0
}

AUDIT="$REPO_ROOT/installers/lib/check_classification.py"
if [[ ! -x "$AUDIT" ]]; then
    echo "pre-commit: $AUDIT not found or not executable, skipping." >&2
    exit 0
fi

if ! python3 "$AUDIT" --staged --quiet; then
    echo "" >&2
    echo "pre-commit: classification audit FAILED. Commit refused." >&2
    echo "Fix the violations above, or commit with --no-verify to override." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Identity leak gate.
#
# gitleaks (below) finds credentials. It has no opinion about a tenant email
# domain, a colleague's name or an internal meeting title -- strings that are
# just as unpublishable and reach a public commit far more easily, through
# docstrings, comments and test fixtures.
#
# Scans the INDEX, not the working tree. A new file is untracked until it is
# staged, so a working-tree scan run while writing it reports clean; that
# sequence is exactly how identity strings got one keystroke from a public
# commit. The index is the last honest checkpoint.
#
# The deny-list of real values is gitignored -- committing it would publish
# what it protects -- so a fresh clone runs only the generic address rule and
# says so. Build the local list with:
#     installers/lib/check_identity_leak.py --init
LEAK="$REPO_ROOT/installers/lib/check_identity_leak.py"
if [[ -x "$LEAK" ]]; then
    if ! python3 "$LEAK" --staged --quiet; then
        echo "" >&2
        echo "pre-commit: identity leak scan FAILED. Commit refused." >&2
        echo "Override with --no-verify only if the hit is genuinely a placeholder." >&2
        exit 1
    fi
else
    echo "pre-commit: $LEAK not found or not executable, skipping." >&2
fi

# ---------------------------------------------------------------------------
# Standing security checks, fast subset.
#
# Only the two passes that stop an irreversible mistake on a PUBLIC repo: a
# committed secret, and a shell script that will not parse. Both run in about a
# second. semgrep and pip-audit are deliberately NOT here -- a hook that costs a
# minute is a hook people learn to bypass, and a bypassed gate is worse than an
# honest one. Those run before a release or a packet build; see CLAUDE.md.
#
# Artifacts go to a temp directory: a hook firing many times a day should not
# accumulate dated evidence. The path is printed on failure so the detail is
# still reachable.
CHECKS="$REPO_ROOT/installers/lib/security-checks.sh"
if [[ -x "$CHECKS" ]]; then
    HOOK_ARTIFACTS="$(mktemp -d -t obsidian_precommit)"
    if ! "$CHECKS" --fast --artifacts "$HOOK_ARTIFACTS" >/dev/null 2>&1; then
        echo "" >&2
        echo "pre-commit: security checks FAILED. Commit refused." >&2
        echo "Details: $HOOK_ARTIFACTS" >&2
        echo "Re-run yourself with: installers/lib/security-checks.sh --fast" >&2
        echo "Override with --no-verify only if you know why." >&2
        exit 1
    fi
    rm -rf "$HOOK_ARTIFACTS"
else
    echo "pre-commit: $CHECKS not found or not executable, skipping." >&2
fi

exit 0
