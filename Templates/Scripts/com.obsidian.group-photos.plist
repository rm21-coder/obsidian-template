<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Group Photos LaunchAgent

  Keeps Groups/*.md member rows showing real headshots. Runs two stdlib-only
  scripts in order, once nightly:

    1. Templates/Scripts/insert_group_placeholders.py
         Prepends "![[placeholder-person.png|40]] " to any line that is a
         bare person wikilink (e.g. "[[Doe, Jane]]") with no image at all.
         It never touches a line that already has an "![[...]]" reference.

    2. Templates/Scripts/refresh_groups.py
         Swaps "placeholder-person.png" for the real photo when a matching
         file (LastName-FirstName.{png,jpg,jpeg,webp}) now exists in
         Z_attachments/. Never modifies a non-placeholder reference.

  Running insert before refresh means a newly-added member who already has a
  headshot gets upgraded to the real photo in the same nightly pass. A member
  with no headshot yet just gets the placeholder, which is upgraded on a later
  night once the photo is added.

  Both scripts derive the vault root from their own location (two levels
  above Templates/Scripts/), so no vault path needs to be configured. Override
  with the OBSIDIAN_VAULT env var only for testing. They import nothing but
  the standard library, so they run under `python3 -I`: neither the script's
  folder nor the current directory is put on sys.path, and PYTHON* variables
  are ignored. They lived in Z_attachments/ until 2026-10-20; that folder is
  synced attachments, outside every integrity scope (finding 5278622).

  To install:
    1. Replace YOUR_USERNAME below with your macOS short username (and adjust
       the vault path if you did not put the vault at ~/Obsidian/).
    2. cp Templates/Scripts/com.obsidian.group-photos.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/com.obsidian.group-photos.plist

  To reload after changes:
    launchctl unload ~/Library/LaunchAgents/com.obsidian.group-photos.plist
    launchctl load ~/Library/LaunchAgents/com.obsidian.group-photos.plist

  Schedule: daily at 02:00 local time.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.obsidian.group-photos</string>

    <!-- 077: files this job writes (notes, state, logs) are readable by
         this account only, not by other local accounts. -->
    <key>Umask</key>
    <integer>63</integer>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>/usr/bin/python3 -I /Users/YOUR_USERNAME/Obsidian/Templates/Scripts/insert_group_placeholders.py &amp;&amp; /usr/bin/python3 -I /Users/YOUR_USERNAME/Obsidian/Templates/Scripts/refresh_groups.py</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Bytecode never written into, or read from, the synced vault:
             a .pyc planted in Templates/Scripts/__pycache__ would
             otherwise be loaded in place of the reviewed source. -->
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
        <key>PYTHONPYCACHEPREFIX</key>
        <string>/Users/YOUR_USERNAME/Library/Caches/obsidian-template/pycache</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/group-photos.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/group-photos.log</string>
</dict>
</plist>
