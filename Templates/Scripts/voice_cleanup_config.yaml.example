# Voice Cleanup Configuration
#
# Copy this file to voice_cleanup_config.yaml and edit to match your setup.
# API key is loaded from ~/dev/secrets/.env (ANTHROPIC_API_KEY) — edit the
# load_dotenv() path in voice_cleanup.py if your secrets live elsewhere.

# Claude model to use for cleanup
# Anthropic's id. Through a gateway it is sent under the gateway's own name
# for the same model (e.g. "claude-sonnet-5.5") automatically; llm_endpoint
# matches it against the gateway's /v1/models.
claude_model: "claude-sonnet-5-5"

# Path to your Obsidian vault. Leave it unset: the script finds the vault it
# sits in, and any other value is refused (the job exits with
# "vault_path ... is not this vault") so an edited config cannot send notes
# into another folder.
# vault_path: "/Users/yourname/your-vault"

# Watch folder — where dictation drops land. Leave this commented out unless
# you really need a different folder: unset, it is resolved by
# source_media.drop_dir ("~/SourceMedia/VoiceInput"), which is the same
# function source_mail_pull.py writes through. Setting it here is how the
# watcher and the mail transport end up on different folders, and the failure
# is silent — drops are delivered into a folder nothing drains. A value
# outside ~/SourceMedia (after resolving symlinks) is refused, and so is
# ~/SourceMedia itself: every .txt in the folder is sent to the model and then
# deleted, so it must not be pointable at an arbitrary folder.
# watch_folder: "~/SourceMedia/VoiceInput"
