# Secrets
.env
voice_cleanup_config.yaml

# Install profiles. A real one names internal endpoints, tenant domains, and
# connector names — fine to hand a colleague, a disclosure decision to publish.
# Templates (*.env.example) are tracked; profiles are not. `git add -f` if you
# decide a given profile is publishable.
installers/profiles/*.env
# ...and one dropped at the vault root by mistake. The checkout IS the vault,
# so an unignored profile here is one `git add -A` away from publishing
# internal endpoints. The installers refuse to source one from here (it is
# synced and invisible to git): keep a profile in installers/profiles/ or
# outside the vault, e.g. ~/Downloads.
/*.env

# macOS noise
.DS_Store

# Python virtual environment used by Templates/Scripts/
Templates/Scripts/.venv/
# The test suite's own venv (tests/run_tests.sh, from requirements-dev.lock)
Templates/Scripts/.venv-test/
Templates/Scripts/__pycache__/

# Bytecode cache from running installers/lib scripts directly (e.g. check_classification.py)
installers/lib/__pycache__/

# Generated by Templates/Scripts/tests/run_tests.sh
Templates/Scripts/tests/__pycache__/
Templates/Scripts/tests/coverage_html/
Templates/Scripts/tests/.coverage
# pytest run from any other cwd drops a coverage DB there too; it embeds
# absolute local paths, which must not reach a public repo.
**/.coverage
.coverage
.pytest_cache/

# Per-user Obsidian state — the workspace layout is unique to each machine
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Generated per-machine output — the morning dashboard writes HTML here
Z_dashboards/
# Plugin code/binaries are downloaded by install.sh's 30-plugins component;
# never check those in. But the per-plugin settings (data.json) drive the
# ribbon icons, QuickAdd choices, etc., so they ARE tracked — selectively.
# Pattern: ignore contents of plugins/, then re-include specific subdirs
# AND the specific data.json files inside them. Note: must use
# ".obsidian/plugins/*" (no trailing slash) so git still descends and
# evaluates the negation rules below.
.obsidian/plugins/*
!.obsidian/plugins/cmdr/
.obsidian/plugins/cmdr/*
!.obsidian/plugins/cmdr/data.json
!.obsidian/plugins/quickadd/
.obsidian/plugins/quickadd/*
!.obsidian/plugins/quickadd/data.json
!.obsidian/plugins/obsidian-tasks-plugin/
.obsidian/plugins/obsidian-tasks-plugin/*
!.obsidian/plugins/obsidian-tasks-plugin/data.json
!.obsidian/plugins/omnisearch/
.obsidian/plugins/omnisearch/*
!.obsidian/plugins/omnisearch/data.json
!.obsidian/plugins/obsidian-meta-bind-plugin/
.obsidian/plugins/obsidian-meta-bind-plugin/*
!.obsidian/plugins/obsidian-meta-bind-plugin/data.json

# Tag tracking files written by Templates/Scripts/tag_clippings.py
.tag_tracking.json
.tag_km_tracking.json
# The classifier's own tracking file (classify_notes.py, at the vault root)
.classification_tracking.json

# Promotion-candidate audit log (per-vault, not portable)
Templates/Scripts/tag-promotion-candidates.md
Templates/Scripts/last-tag-diff.md

# Regenerable per-run scratch state written by Templates/Scripts/*.py
Templates/Scripts/.locks/
Templates/Scripts/.state/
Templates/Scripts/.config/
Templates/Scripts/logs/

# Content folders -- everything that lands here is a note you wrote, a file
# you attached, or demo data seed_demo_content.py generated, and none of it
# belongs in a public template repo. The repo IS the vault, so a user's real
# People and Meetings notes sit in this working tree; until 2026-10-11 only four
# of these folders were ignored, and a Windows install had 61 People notes with
# real names one `git add .` away from a commit (the commit-time gates only
# run where the hooks are installed). Every content folder is ignored now.
#
# "dir/**" ignores every file below the folder; "!dir/**/" re-includes the
# subfolders so git still descends and evaluates "!dir/**/.gitkeep", which
# keeps the structure (Notes/Dashboards/ and the rest) through a clone and a
# demo teardown. The few files that are meant to ship are re-included by
# name; anything else needs a line here or `git add -f`. A new content
# folder needs its three lines too: test_platform_hardening.py checks.
Actions/**
!Actions/**/
!Actions/**/.gitkeep
Categories/**
!Categories/**/
!Categories/**/.gitkeep
Clippings/**
!Clippings/**/
!Clippings/**/.gitkeep
Creations/**
!Creations/**/
!Creations/**/.gitkeep
Daily/**
!Daily/**/
!Daily/**/.gitkeep
Groups/**
!Groups/**/
!Groups/**/.gitkeep
Knowledge/**
!Knowledge/**/
!Knowledge/**/.gitkeep
Meetings/**
!Meetings/**/
!Meetings/**/.gitkeep
Notes/**
!Notes/**/
!Notes/**/.gitkeep
People/**
!People/**/
!People/**/.gitkeep
Topics/**
!Topics/**/
!Topics/**/.gitkeep
Z_archive/**
!Z_archive/**/
!Z_archive/**/.gitkeep
Z_attachments/**
!Z_attachments/**/
!Z_attachments/**/.gitkeep
!Z_archive/Completed Tasks.md
!Z_attachments/placeholder-person.png

# Generated by classify_notes.py on every run. Both are indexes of where a
# vault's sensitive notes sit, so neither may reach a public repo if the
# classifier is ever run against this checkout (e.g. over the demo dataset).
Actions/Classification Review.md
Templates/Scripts/last-classification-review.md

# git filter-repo / filter-branch leftovers
.git-rewrite/

# Local identity deny-list for the pre-commit identity scan. Holds the real
# tenant domains and colleague names that must never reach a public commit —
# so committing the list itself would publish exactly what it protects.
# Regenerate with: installers/lib/check_identity_leak.py --init
installers/lib/identity-denylist.local
# Contributors who agreed to be named in commit headers (exact identities).
installers/lib/identity-allowed-identities.local

# Claude Code session state and agent worktrees (full copies of the repo)
.claude/

# Obsidian's own trash folder (when "Files & links > Deleted files" is set to it)
.trash/
